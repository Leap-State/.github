n","# ==========================================\n","# 1. DATA LAYER (The Shared Source of Truth)\n","# ==========================================\n","\n","def generate_initial_data():\n","    \"\"\"Generates the starting public dataset.\"\"\"\n","    products_list = [\n","        (\"Organic Milk\", \"Dairy\"), (\"Fresh Avocado\", \"Produce\"), \n","        (\"Greek Yogurt\", \"Dairy\"), (\"Sourdough Bread\", \"Bakery\"),\n","        (\"Almond Milk\", \"Beverages\"), (\"Red Apples\", \"Produce\"),\n","        (\"Dark Chocolate\", \"Snacks\"), (\"Avocado Toast Kit\", \"Bakery\")\n","    ]\n","    stores = [\"Corner Market\", \"Green Grocer\", \"City SuperMart\", \"Local Pantry\", \"Organic Hub\"]\n","    data = []\n","    today = datetime.date.today()\n","\n","    for _ in range(30):\n","        p_name, p_cat = random.choice(products_list)\n","        store = random.choice(stores)\n","        dist = round(random.uniform(0.5, 10.0), 1)\n","        qty = random.randint(5, 50)\n","        price = round(random.uniform(3.0, 12.0), 2)\n","        expiry = today + datetime.timedelta(days=random.randint(5, 30))\n","        data.append({\n","            \"Product\": p_name, \"Category\": p_cat, \"Store_Name\": store,\n","            \"Distance_km\": dist, \"Stock_Qty\": qty, \"Expiry_Date\": expiry,\n","            \"Price\": price, \"Last_Updated\": today, \"Discount\": \"0%\"\n","        })\n","    return pd.DataFrame(data)\n","\n","# Initialize the Shared DataFrame\n","public_inventory = generate_initial_data()\n","\n","# ==========================================\n","# 2. AGENTIC ENGINE (The Intelligence Layer)\n","# ==========================================\n","\n","class LogiflowAgent:\n","    def __init__(self, df):\n","        self.df = df  # This is a reference to the global DataFrame\n","\n","    def search_and_format(self, query):\n","        \"\"\"USER SIDE: Search and display results.\"\"\"\n","        results = self.df[self.df['Product'].str.contains(query, case=False, na=False)]\n","        \n","        if results.empty or results['Stock_Qty'].sum() == 0:\n","            return self.handle_fallback()\n","\n","        html_output = \"<h3 style='color: #2c3e50;'>📍 Local Availability:</h3><div style='display: flex; flex-wrap: wrap; gap: 15px;'>\"\n","        today = datetime.date.today()\n","\n","        for _, row in results.iterrows():\n","            # Check for Zero Waste status\n","            days_to_exp = (row['Expiry_Date'] - today).days\n","            is_zero_waste = row['Discount'] != \"0%\" or days_to_exp < 3\n","            \n","            discount_tag = \"\"\n","            if is_zero_waste:\n","                discount_tag = f'<div style=\"background-color: #e74c3c; color: white; padding: 4px; border-radius: 4px; font-size: 10px; font-weight: bold; margin-top: 5px;\">🔥 LOGIFLOW ZERO WASTE DEAL</div>'\n","\n","            html_output += f\"\"\"\n","            <div style=\"border: 1px solid #ddd; border-radius: 8px; padding: 15px; width: 220px; background-color: white; box-shadow: 2px 2px 10px rgba(0,0,0,0.1); font-family: sans-serif;\">\n","                <div style=\"font-size: 11px; color: #27ae60; font-weight: bold;\">✅ {row['Store_Name']} (Verified)</div>\n","                <div style=\"font-size: 15px; font-weight: bold; color: #2c3e50; margin: 5px 0;\">{row['Product']}</div>\n","                <div style=\"font-size: 13px; color: #7f8c8d;\">📍 {row['Distance_km']} km away</div>\n","                <div style=\"font-size: 16px; font-weight: bold; color: #2c3e50; margin-top: 5px;\">${row['Price']:.2f}</div>\n","                {discount_tag}\n","                <div style=\"font-size: 10px; color: #95a5a6; margin-top: 5px;\">Exp: {row['Expiry_Date']}</div>\n","            </div>\n","            \"\"\"\n","        html_output += \"</div>\"\n","        return html_output\n","\n","    def handle_fallback(self):\n","        return \"\"\"<div style=\"padding: 20px; border: 2px dashed #e74c3* ; border-radius: 10px; background-color: #fdf2f2; text-align: center; font-family: sans-serif;\">\n","            <h3 style=\"color: #c0392b;\">⚠️ No local stock verified today.</h3>\n","            <a href=\"https://www.google.com/shopping\" target=\"_blank\" style=\"color: #3498db;\">Redirecting to Global Google Shopping...</a>\n","            </div>\"\"\"\n","\n","    def update_inventory(self, new_entry: dict):\n","        \"\"\"SELLER SIDE: Upsert logic to update or append data.\"\"\"\n","        global public_inventory\n","        \n","        # Check if (Product + Store) already exists for UPSERT logic\n","        mask = (public_inventory['Product'] == new_entry['Product']) & \\\n","               (public_inventory['Store_Name'] == new_entry['Store_Name'])\n","        \n","        new_row = pd.DataFrame([new_entry])\n","        \n","        if not self.df[mask].empty:\n","            # UPDATE existing\n","            self.df.loc[mask, ['Stock_Qty', 'Price', 'Expiry_Date', 'Last_Updated', 'Discount']] = \\\n","                [new_entry['Stock_Qty'], new_entry['Price'], new_entry['Expiry_Date'], \n","                 new_entry['Last_Updated'], new_entry['Discount']]\n","            return \"✅ Stock Updated Successfully!\"\n","        else:\n","            # APPEND new\n","            self.df = pd.concat([self.df, new_row], ignore_index=True)\n","            return \"✅ New Product Registered & Broadcasted!\"\n","\n","# Initialize Agent with the shared reference\n","agent = LogiflowAgent(public_inventory)\n","\n","# ==========================================\n","# 3. INTERACTIVE UI (Seller & User)\n","# ==========================================\n","\n","# --- USER SIDE WIDGETS ---\n","user_search_input = widgets.Text(placeholder='e.g. Milk', description='🔍 Product:', layout=widgets.Layout(width='250px'))\n","user_search_btn = widgets.Button(description='Find Nearby', button_style='info', icon='search')\n","user_output = widgets.Output()\n","\n","# --- SELLER SIDE WIDGETS ---\