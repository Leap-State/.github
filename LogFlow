Updated\": datetime.datetime.now(),\n","                \"Discount\": applied_discount\n","            }\n","\n","            # 3. Sync with Shared DataFrame\n","            msg = agent.update_inventory(new_data)\n","            print(f\"✨ {msg}\")\n","            \n","        except Exception as e:\n","            print(f\"❌ Error: {str(e)}\")\n","\n","user_search_btn.on_click(on_search_clicked)\n","s_submit.on_click(on_seller_submit)\n","\n","# ==========================================\n","# 4. FINAL LAYOUT (The Dashboard)\n","# ==========================================\n","\n","# Styling the sections\n","header_html = \"\"\"\n","<div style=\"background-color: #2c3e50; padding: 20px; border-radius: 10px; text-align: center; color: white; font-family: sans-serif;\">\n","    <h1 style=\"margin: 0;\">🚀 Logiflow Intelligence Bridge</h1>\n","    <p style=\"opacity: 0.8;\">Connecting Local Sellers to Global Consumers</p>\n","</div>\n","\"\"\"\n","\n","seller_ui = widgets.VBox([\n","    widgets.HTML(\"<h3>🏪 Seller Dashboard</h3>\"),\n","    s_prod, s_qty, s_price, s_exp, s_store, s_discount, s_submit, seller_output\n","], layout=widgets.Layout(padding='10px', border='1px solid #bdc3c7', border_radius='10px', width='400px'))\n","\n","user_ui = widgets.VBox([\n","    widgets.HTML(\"<h3>🛒 User Search Portal</h3>\"),\n","    widgets.HBox([user_search_input, user_search_btn]),\n","    user_output\n","], layout=widgets.Layout(padding='10px', border='1px solid #bdc3c7', border_radius='10px', width='500px'))\n","\n","dashboard = widgets.VBox([\n","    widgets.HTML(header_html),\n","    widgets.HBox([seller_ui, user_ui], layout=widgets.Layout(justify_content='space-around', margin='20px 0'))\n","])\n","\n","display(dashboard)"]},{"cell_type":"markdown","id":"67f40760","metadata":{"papermill":{"duration":0.003504,"end_time":"2026-05-12T12:14:37.503051+00:00","exception":false,"start_time":"2026-05-12T12:14:37.499547+00:00","status":"completed"},"tags":[]},"source":["## This proj